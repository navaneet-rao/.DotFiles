{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "blue",
      "2": "green",
      "3": "yellow",
    },
    "padding": {
      "top": 5,
    },
  },
  "display": {
    "separator": "   ",
    "color": "yellow",
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌───────────────────── \u001b[1mHardware Information\u001b[0m ──────────────────────────┐",
    },
    {
      "type": "host",
      "key": "  󰌢 ",
    },
    {
      "type": "board",
      "key": "   ",
    },
    {
      "type": "cpu",
      "key": "   ",
    },
    {
      "type": "cpucache",
      "key": "  󱘿 ",
    },
    {
      "type": "gpu",
      "detectionMethod": "pci",
      "key": "   ",
    },
    {
      "type": "memory",
      "key": "   ",
    },
    {
      "type": "disk",
      "key": "   ",
      "format": "{1}: {2} GB free of {3} GB",
    },
    {
      "type": "battery",
      "key": "   ",
    },
    {
      "type": "camera",
      "key": "   ",
    },
    {
      "type": "tpm",
      "key": "  󰒃 ",
    },
    {
      "type": "display",
      "key": "  󱄄 ",
    },
    {
      "type": "terminalsize",
      "key": "   ",
    },
    {
      "type": "custom",
      "format": "├──────────────────────── \u001b[1mSoftware Information\u001b[0m ────────────────────────┤",
    },
    {
      "type": "os",
      "key": "   ",
    },
    {
      "type": "kernel",
      "key": "   ",
      "format": "{1} {2}",
    },
    {
      "type": "wm",
      "key": "   ",
    },
    {
      "type": "de",
      "key": "   ",
    },
    {
      "type": "shell",
      "key": "   ",
    },
    {
      "type": "packages",
      "key": "   ",
    },
    {
      "type": "editor",
      "key": "   ",
    },
    {
      "type": "bootmgr",
      "key": "  󰍦 ",
    },
    {
      "type": "initsystem",
      "key": "   ",
    },
    {
      "type": "opengl",
      "key": "   ",
    },
    {
      "type": "custom",
      "format": "├─────────────────────────── \u001b[1mUptime / Age\u001b[0m ─────────────────────────────┤",
    },
    {
      "type": "command",
      "key": "  OS Age ",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "  Uptime ",
      "keyColor": "magenta",
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────────────────────┘",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
    },
  ],
}
