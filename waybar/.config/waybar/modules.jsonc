{
    "include": [
        "$HOME/.config/waybar/modules/battery.jsonc",
        "$HOME/.config/waybar/modules/idle_inhibitor.jsonc",
        "$HOME/.config/waybar/modules/custom-wbar.jsonc",
        "$HOME/.config/waybar/modules/custom-wallchange.jsonc",
        "$HOME/.config/waybar/modules/network.jsonc",
        "$HOME/.config/waybar/modules/pulseaudio-microphone.jsonc",
        "$HOME/.config/waybar/modules/padding-modules.jsonc",
        "$HOME/.config/waybar/modules/tray.jsonc",
        "$HOME/.config/waybar/modules/custom-theme.jsonc",
        "$HOME/.config/waybar/modules/clock.jsonc",
        "$HOME/.config/waybar/modules/custom-cliphist.jsonc",
        "$HOME/.config/waybar/modules/custom-power.jsonc",
        "$HOME/.config/waybar/modules/blacklight.jsonc",
        "$HOME/.config/waybar/modules/custom-notifications.jsonc",
        "$HOME/.config/waybar/modules/hyprland-workspaces.jsonc",
        "$HOME/.config/waybar/modules/wlr-taskbar.jsonc",
        "$HOME/.config/waybar/modules/mpris.jsonc",
    ],
    "custom/expand-icon-1": {
        "format": "︙"
    },
    "group/expand-1": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 599,
            "children-class": "not-power",
            "transition-to-left": false,
            "hover-to-reveal": true
            // "click-to-reveal": true
        },
        "modules": [
            "custom/expand-icon-1",
            "backlight",
            "backlight/slider",
            "pulseaudio",
            "pulseaudio/slider",
            "pulseaudio#microphone",
            "network"
        ]
    },
    "backlight/slider": {
        "min": 4,
        "max": 99,
        "rotate": -1,
        "device": "intel_backlight",
        "scroll-step": 0
    },
    "pulseaudio/slider": {
        "min": 4,
        "max": 99,
        "rotate": -1,
        "device": "pulseaudio",
        "scroll-step": 0
    }
}
