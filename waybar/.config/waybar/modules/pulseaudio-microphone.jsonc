{
    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "rotate": 0,
        "format-muted": "婢",
        "on-click": "pavucontrol -t 3",
        "tooltip-format": "{icon} {desc} - {volume}%",
        "scroll-step": 5,
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [
                " ",
                " ",
                " "
            ]
        }
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "rotate": 0,
        "format-source": " ",
        "format-source-muted": " ",
        "on-click": "pavucontrol -t 4",
        "tooltip-format": "{format_source} {source_desc} - {source_volume}%",
        "scroll-step": 5
    }
}
