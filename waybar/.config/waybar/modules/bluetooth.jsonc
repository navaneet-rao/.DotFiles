{
  "bluetooth": {
    // "controller": "controller1", // specify the alias of the controller if there are multiple controllers (optional)
    "format": "󰂯 {status}",
    "format-on": "󰂯 Bluetooth On",
    "format-off": "󰂲 Bluetooth Off",
    "format-disabled": "󰂳 Disabled",
    "format-connected": "󰂱 {num_connections} ",
